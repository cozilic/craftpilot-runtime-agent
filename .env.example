# CraftPilot master origin (no /api path).
CRAFTPILOT_MASTER_URL=https://craftpilot.se

# Optional one-time token: set only after a sysadmin explicitly re-enables this node.
CRAFTPILOT_REGISTRATION_TOKEN=

# Filled automatically by ./setup.sh from /var/run/docker.sock.
DOCKER_GID=__DOCKER_GID__

# Persistent Minecraft server data, mounted at the same host path for Docker.
CRAFTPILOT_SERVER_DATA_HOST_PATH=/srv/craftpilot/servers
CRAFTPILOT_SERVER_DATA_GID=33
CRAFTPILOT_DOCKER_NETWORK=craftpilot-servers
